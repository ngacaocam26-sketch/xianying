# Only the Node backend reads these values. Never use a VITE_ prefix for secrets.
# Create a Beijing-region API key in Alibaba Cloud Bailian, then fill it locally.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_REALTIME_VOICE=Tina

# Optional: fill your Beijing workspace ID to use its dedicated endpoint.
# Empty uses the official Beijing DashScope compatibility endpoint.
DASHSCOPE_WORKSPACE_ID=
