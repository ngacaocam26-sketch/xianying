{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "显影：启动并预览",
      "detail": "启动网页与本地 AI 接口，在浏览器打开实际地址；修改 .env 或后端后需重启此任务。",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--open"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
